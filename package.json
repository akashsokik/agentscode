{
  "name": "agentscode",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "productName": "AgentsCode",
  "description": "An IDE where Claude Code, Codex and OrcaCode agents work side by side and talk to each other.",
  "license": "MIT",
  "author": "AgentsCode",
  "homepage": "https://orcapods.ai/agentscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/akashsokik/agentscode.git"
  },
  "main": "out/electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "vite build && node server/index.ts",
    "build:desktop": "node scripts/prepare-pty.mjs && vite build --outDir out/dist && tsc -p tsconfig.desktop.json",
    "desktop": "npm run build:desktop && electron .",
    "dist:mac": "npm run build:desktop && electron-builder --mac --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.desktop.json",
    "test": "node --test tests/*.test.ts",
    "dist:win": "npm run build:desktop && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build:desktop && electron-builder --linux --x64 --publish never",
    "release:notes": "node scripts/release.mjs notes",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:tag": "node scripts/release.mjs tag"
  },
  "engines": {
    "node": ">=23.6"
  },
  "build": {
    "appId": "com.agentscode.app",
    "productName": "AgentsCode",
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": false,
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "akashsokik",
        "repo": "agentscode",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "Claude Code, Codex and OrcaCode agents side by side",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openuidev/lang-core": "^1.1.0",
    "@openuidev/react-lang": "^1.1.0",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "mermaid": "^11.17.2",
    "node-pty": "^1.1.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "ghostty-web": "^0.4.0",
    "highlight.js": "^11.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
